{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexTerm",
  "version": "2.14.0",
  "identifier": "com.nexterm.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NexTerm",
        "width": 1600,
        "height": 1000,
        "fullscreen": false,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
